#!/bin/sh /etc/rc.common
# /etc/init.d/portal —— 校园网 Portal 自动登录守护服务
# 周期检测连通性, 掉线自动重登
# 推荐: 在项目目录执行 sh install.sh 自动完成部署
# 手动安装: cp portal.init /etc/init.d/portal && chmod +x /etc/init.d/portal
#           /etc/init.d/portal enable && /etc/init.d/portal start

USE_PROCD=1
START=99
STOP=10
PROG="/usr/bin/portal_login.sh"

# 检测周期(秒), 可在 /etc/portal.conf 中用 INTERVAL= 覆盖
[ -r /etc/portal.conf ] && . /etc/portal.conf
INTERVAL="${INTERVAL:-60}"

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c "while true; do $PROG; sleep $INTERVAL; done"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
